#!/bin/zsh
# Packs OrcaPortable-<date>.zip for Windows: the fork's Windows app (built by the
# fork-portable-win GitHub workflow), claude.exe / codex.exe, PortableGit, and this Mac's
# Claude and Codex subscriptions. Secrets are added here, never in CI.
#
#   orca-portable-pack                 # newest successful Windows build of the fork
#   orca-portable-pack --build         # build the current `custom` first (~25 min on GitHub)
#   orca-portable-pack --no-codex --no-git --out ~/Desktop
#   orca-portable-pack --refresh-claude-token
set -euo pipefail

REPO="$HOME/projects/mac_soft/orca"
GH_REPO="Roughriver74/orca"
WORKFLOW="fork-portable-win.yml"
ARTIFACT="OrcaPortable-app-win-x64"
CACHE="$HOME/.local/share/orca-custom/portable"
KEYCHAIN_SERVICE="orca-portable-claude-token"
CLAUDE_DIST="https://downloads.claude.ai/claude-code-releases"

build=0 with_claude=1 with_codex=1 with_git=1 refresh_token=0 out="$HOME/Downloads"
while (( $# )); do
  case "$1" in
    --build) build=1 ;;
    --no-claude) with_claude=0 ;;
    --no-codex) with_codex=0 ;;
    --no-git) with_git=0 ;;
    --refresh-claude-token) refresh_token=1 ;;
    --out) out="$2"; shift ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) print -u2 "unknown option: $1"; exit 2 ;;
  esac
  shift
done

# Why stderr: helper functions return paths and tokens on stdout.
log() { print -u2 -r -- "==> $*"; }
die() { print -u2 -r -- "error: $*"; exit 1; }
sha256_of() { shasum -a 256 "$1" | cut -d' ' -f1; }
mkdir -p "$CACHE"

trigger_build() {
  local sha tag run_id=""
  sha=$(git -C "$REPO" rev-parse custom)
  tag="portable-${sha[1,12]}"
  if ! git -C "$REPO" ls-remote --exit-code origin "refs/tags/$tag" >/dev/null 2>&1; then
    log "pushing tag $tag (branch custom itself is not pushed)"
    git -C "$REPO" push -q origin "$sha:refs/tags/$tag"
  fi
  log "waiting for the GitHub Windows build of ${sha[1,12]}"
  for _ in {1..30}; do
    run_id=$(gh run list -R "$GH_REPO" --workflow "$WORKFLOW" --commit "$sha" --limit 1 \
      --json databaseId -q '.[0].databaseId // empty')
    [[ -n "$run_id" ]] && break
    sleep 10
  done
  [[ -n "$run_id" ]] || die "no workflow run appeared; is Actions enabled at https://github.com/$GH_REPO/actions ?"
  gh run watch "$run_id" -R "$GH_REPO" --exit-status --interval 30 >/dev/null || die "Windows build failed: gh run view $run_id -R $GH_REPO --log-failed"
}

(( build )) && trigger_build
run_json=$(gh run list -R "$GH_REPO" --workflow "$WORKFLOW" --status success --limit 1 \
  --json databaseId,headSha,createdAt -q '.[0] // empty')
[[ -n "$run_json" ]] || die "no successful Windows build yet; run with --build"
run_id=$(jq -r .databaseId <<<"$run_json")
run_sha=$(jq -r .headSha <<<"$run_json")
if [[ "$run_sha" != "$(git -C "$REPO" rev-parse custom)" ]]; then
  log "note: newest Windows build is ${run_sha[1,12]}, custom is at $(git -C "$REPO" rev-parse --short=12 custom); use --build to rebuild"
fi

app_dir="$CACHE/app-$run_id"
if [[ ! -f "$app_dir/Orca.exe" ]]; then
  log "downloading Windows app from run $run_id"
  rm -rf "$app_dir"
  gh run download "$run_id" -R "$GH_REPO" -n "$ARTIFACT" -D "$app_dir"
  [[ -f "$app_dir/Orca.exe" ]] || die "artifact has no Orca.exe"
fi

fetch_claude() {
  local version manifest checksum file
  version=$(curl -fsSL "$CLAUDE_DIST/latest")
  [[ "$version" =~ '^[0-9]+\.[0-9]+\.[0-9]+' ]] || die "unexpected Claude version: $version"
  file="$CACHE/claude-$version-win32-x64.exe"
  if [[ ! -f "$file" ]]; then
    log "downloading claude.exe $version"
    manifest=$(curl -fsSL "$CLAUDE_DIST/$version/manifest.json")
    checksum=$(jq -r '.platforms["win32-x64"].checksum' <<<"$manifest")
    curl -fsSL -o "$file.part" "$CLAUDE_DIST/$version/win32-x64/claude.exe"
    [[ "$(sha256_of "$file.part")" == "$checksum" ]] || { rm -f "$file.part"; die "claude.exe checksum mismatch"; }
    mv "$file.part" "$file"
  fi
  print -r -- "$file"
}

# GitHub release asset with its published sha256 digest verified.
fetch_release_asset() {
  local repo=$1 pattern=$2 tag name digest file
  local release
  release=$(gh api "repos/$repo/releases/latest")
  tag=$(jq -r .tag_name <<<"$release")
  read -r name digest < <(jq -r --arg p "$pattern" \
    '.assets[] | select(.name | test($p)) | [.name, .digest] | @tsv' <<<"$release" | head -1)
  [[ -n "$name" ]] || die "no asset matching $pattern in $repo $tag"
  file="$CACHE/$tag-$name"
  if [[ ! -f "$file" ]]; then
    log "downloading $name ($repo $tag)"
    gh release download "$tag" -R "$repo" -p "$name" -O "$file.part" --clobber
    if [[ "$digest" == sha256:* && "$(sha256_of "$file.part")" != "${digest#sha256:}" ]]; then
      rm -f "$file.part"; die "$name checksum mismatch"
    fi
    mv "$file.part" "$file"
  fi
  print -r -- "$file"
}

claude_token() {
  local token=""
  (( refresh_token )) || token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)
  if [[ -z "$token" ]]; then
    log "Claude: issuing a long-lived subscription token (browser opens; copy the sk-ant-oat... token it prints)"
    claude setup-token </dev/tty >/dev/tty 2>&1 || true
    print -n "Paste the token: " >/dev/tty
    read -rs token </dev/tty
    print >/dev/tty
    [[ "$token" == sk-ant-oat* ]] || die "that does not look like a Claude OAuth token (sk-ant-oat...)"
    security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$USER" -w "$token"
  fi
  print -r -- "$token"
}

stage="$CACHE/stage/OrcaPortable"
rm -rf "$CACHE/stage"
mkdir -p "$stage/bin" "$stage/home" "$stage/secrets"
trap 'rm -rf "$CACHE/stage"' EXIT
log "assembling"
cp -R "$app_dir" "$stage/app"
for f in Start-Orca.cmd Remove-Orca.cmd; do
  # Why CRLF: cmd.exe misparses labels and blocks in LF-only batch files.
  sed $'s/\r$//; s/$/\r/' "$REPO/fork/portable/$f" >"$stage/$f"
done
cp "$REPO/fork/portable/README.txt" "$stage/README.txt"

if (( with_claude )); then
  cp "$(fetch_claude)" "$stage/bin/claude.exe"
  claude_token >"$stage/secrets/claude-token.txt"
  # Why: with a token-only login Claude Code would otherwise start its first-run onboarding.
  print -r -- '{"hasCompletedOnboarding": true}' >"$stage/home/.claude.json"
fi

if (( with_codex )); then
  codex_zip=$(fetch_release_asset openai/codex '^codex-x86_64-pc-windows-msvc\.exe\.zip$')
  unzip -q -o "$codex_zip" -d "$stage/bin"
  mv "$stage/bin/codex-x86_64-pc-windows-msvc.exe" "$stage/bin/codex.exe"
  if [[ -f "$HOME/.codex/auth.json" ]]; then
    mkdir -p "$stage/home/.codex"
    cp "$HOME/.codex/auth.json" "$stage/home/.codex/auth.json"
    # Why file: on Windows Codex may otherwise prefer Credential Manager, which ignores auth.json and leaves traces.
    print -r -- 'cli_auth_credentials_store = "file"' >"$stage/home/.codex/config.toml"
  else
    log "note: ~/.codex/auth.json not found; run 'codex login --device-auth' on the server"
  fi
fi

(( with_git )) && cp "$(fetch_release_asset git-for-windows/git '^PortableGit-.*-64-bit\.7z\.exe$')" "$stage/bin/PortableGit.7z.exe"

git_name=$(git config --global user.name || true)
git_email=$(git config --global user.email || true)
if [[ -n "$git_name$git_email" ]]; then
  printf '[user]\n\tname = %s\n\temail = %s\n' "$git_name" "$git_email" >"$stage/home/.gitconfig"
fi

mkdir -p "$out"
zip_path="$out/OrcaPortable-$(date +%Y%m%d-%H%M).zip"
log "zipping"
(cd "$CACHE/stage" && zip -qry -9 "$zip_path" OrcaPortable)
chmod 600 "$zip_path"
log "done: $zip_path ($(du -h "$zip_path" | cut -f1)), app $(cat "$stage/app/orca-portable-version.txt" 2>/dev/null || print unknown)"
print "The archive contains your Claude/Codex subscription tokens. Delete it after copying."
