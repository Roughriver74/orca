#!/bin/zsh
# Self-built Orca (fork Roughriver74/orca, branch `custom`) = latest upstream release + own patches.
#
# Two roles share this script. The maintainer machine rebases patches onto each upstream release and
# pushes `custom` to the fork; followers only build whatever `origin/custom` points at.
# Runs on macOS (arm64, installs /Applications/Orca.app) and Linux (x64, installs ~/.local/opt/Orca).
#
#   orca-custom-update sync       # maintainer: new upstream release? gate it, push, build, stage
#   orca-custom-update follow     # follower: origin/custom moved? build it and stage
#   orca-custom-update gate <ref> # run the type-check/test/build gate against <ref> in the cwd worktree
#   orca-custom-update build      # build current `custom` branch and stage it
#   orca-custom-update install    # swap the staged build in once Orca is not running / is quiet
#   orca-custom-update rollback   # restore the previous build over the current one
#   orca-custom-update bootstrap-follower   # one-time setup on another machine (role, link, scheduler)
#   orca-custom-update status
#
# ORCA_UPDATE_DRY_RUN=1 prints the sync/install/rollback decisions and the actions each would take,
# without mutating anything (no rebase, no push, no file swap, no quit/relaunch).
#
# Patches = commits on `custom` above the release tag it is based on. This script is versioned in the
# fork (fork/orca-custom-update) and linked into PATH, so every machine gets it through git too.
set -euo pipefail

# Why: sync/follow rewrite the checkout that holds this file; run from a private copy so zsh never
# reads a half-replaced script. Skipped when sourced for unit tests (ORCA_CUSTOM_UPDATE_TEST=1).
if [[ -z "${ORCA_CUSTOM_UPDATE_COPY:-}" && -z "${ORCA_CUSTOM_UPDATE_TEST:-}" ]]; then
  copy=$(mktemp "${TMPDIR:-/tmp}/orca-custom-update.XXXXXX")
  cp "$(readlink -f "$0")" "$copy"
  ORCA_CUSTOM_UPDATE_COPY="$copy" exec /bin/zsh "$copy" "$@"
fi
[[ -n "${ORCA_CUSTOM_UPDATE_TEST:-}" ]] || trap 'rm -f "$ORCA_CUSTOM_UPDATE_COPY"' EXIT

REPO="$HOME/projects/mac_soft/orca"
STATE="${ORCA_CUSTOM_UPDATE_STATE:-$HOME/.local/share/orca-custom}"
ROLE_FILE="$STATE/role"
GATE_ROOT="$STATE/gate"
FORK_URL="https://github.com/Roughriver74/orca.git"
UPSTREAM_URL="https://github.com/stablyai/orca.git"
NODE_VERSION="24.2.0"
LINUX_SERVE_SERVICE="orca-serve.service"
LINUX_ORCA_REMOTE="$HOME/.local/bin/orca-remote"
DRY_RUN_MODE=0
[[ "${ORCA_UPDATE_DRY_RUN:-0}" == 1 ]] && DRY_RUN_MODE=1
mkdir -p "$STATE/bin" "$GATE_ROOT"

if [[ "$(uname -s)" == Darwin ]]; then
  IS_MAC=1
  STAGED="$STATE/Orca.app"
  APP="/Applications/Orca.app"
  OFFICIAL_BACKUP="/Applications/Orca.app.bak"
  PREV_APP="$STATE/Orca.prev.app"
  LOG="$HOME/Library/Logs/orca-custom-update.log"
  SCRIPT_LINK="$HOME/bin/orca-custom-update"
  export PATH="$STATE/bin:/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  # Why: Xcode's license is not accepted on this Mac; Command Line Tools compile the native helpers.
  export DEVELOPER_DIR=/Library/Developer/CommandLineTools
  export CSC_IDENTITY_AUTO_DISCOVERY=false
else
  IS_MAC=0
  STAGED="$STATE/Orca-linux"
  # Why: the distro package owns /opt/Orca (root); a user-level install needs no sudo and leaves the
  # packaged app as the fallback.
  APP="$HOME/.local/opt/Orca"
  PREV_APP="$APP.prev"
  LOG="$STATE/update.log"
  SCRIPT_LINK="$HOME/.local/bin/orca-custom-update"
  export PATH="$STATE/bin:$STATE/node$NODE_VERSION/bin:/usr/local/bin:/usr/bin:/bin"
fi

log() { print -r -- "$(date '+%F %T') $*" | tee -a "$LOG" >&2; }

notify() {
  if (( IS_MAC )); then
    osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
  else
    notify-send "$1" "$2" >/dev/null 2>&1 || true
  fi
}

# Portable timeout (no GNU coreutils dependency): runs "$@", killing it after $1 seconds. Every step
# is guarded for `set -e`: a watchdog that already fired, or a job already reaped, must not abort us.
run_with_timeout() {
  local secs=$1; shift
  "$@" &
  local cmd_pid=$!
  ( sleep "$secs"; kill -TERM "$cmd_pid" 2>/dev/null || true ) &
  local watchdog_pid=$!
  local rc=0
  wait "$cmd_pid" 2>/dev/null || rc=$?
  kill "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true
  return "$rc"
}

# Why: the repo pins Node 24 (package.json engines); distros ship newer majors.
ensure_node() {
  (( IS_MAC )) && return 0
  local dir="$STATE/node$NODE_VERSION"
  [[ -x "$dir/bin/node" ]] && return 0
  local tarball="$STATE/node.tar.xz"
  curl -fsSL -o "$tarball" "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-x64.tar.xz"
  mkdir -p "$dir" && tar -xJf "$tarball" -C "$dir" --strip-components=1 && rm -f "$tarball"
}

ensure_toolchain() {
  ensure_node
  export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
  if (( ! IS_MAC )); then
    # Why: Linux corepack shims try pnpm 12 through a removed `bin/pnpm.cjs` entry; corepack still
    # fetches the pinned version, and pnpm's own launcher in that cache runs fine.
    local pinned dir
    pinned=$(node -p "require('$REPO/package.json').packageManager.split('@')[1].split('+')[0]")
    dir="$HOME/.cache/node/corepack/v1/pnpm/$pinned"
    [[ -x "$dir/pnpm" ]] || (cd "$REPO" && corepack install >>"$LOG" 2>&1)
    print -r -- "#!/bin/sh
exec \"$dir/pnpm\" \"\$@\"" >"$STATE/bin/pnpm"
    chmod +x "$STATE/bin/pnpm"
    return 0
  fi
  # Why: package scripts call bare `pnpm`; corepack shims pin the version from package.json.
  [[ -x "$STATE/bin/pnpm" ]] || corepack enable --install-directory "$STATE/bin" pnpm
  # Why: Orca's native helper scripts build per-triple and lipo from `.build/<triple>/release`; Swift
  # 6.4's default swiftbuild engine writes every triple to one path, so force the native build system.
  if [[ ! -x "$STATE/bin/swift" ]]; then
    print -r -- '#!/bin/zsh
if [[ "$1" == build ]]; then shift; exec /usr/bin/swift build --build-system native "$@"; fi
exec /usr/bin/swift "$@"' >"$STATE/bin/swift"
    chmod +x "$STATE/bin/swift"
  fi
  # Why: Command Line Tools lack the x86_64 Swift back-deploy libs; only the arm64 slice runs here.
  if [[ ! -x "$STATE/bin/swiftc" ]]; then
    print -r -- '#!/bin/zsh
args=(); for a in "$@"; do [[ "$a" == x86_64-apple-macosx1[0-2]* ]] && a=x86_64-apple-macosx14.0; args+=("$a"); done
exec /usr/bin/swiftc "${args[@]}"' >"$STATE/bin/swiftc"
    chmod +x "$STATE/bin/swiftc"
  fi
}

# Single instance: a scheduler tick must not start a second build next to a running one.
if [[ -z "${ORCA_CUSTOM_UPDATE_TEST:-}" && "${1:-status}" != status ]]; then
  LOCK="$STATE/lock"
  if ! mkdir "$LOCK" 2>/dev/null; then
    if kill -0 "$(cat "$LOCK/pid" 2>/dev/null)" 2>/dev/null; then
      exit 0
    fi
    rm -rf "$LOCK" && mkdir "$LOCK"
  fi
  print $$ >"$LOCK/pid"
  trap 'rm -rf "$LOCK"; rm -f "$ORCA_CUSTOM_UPDATE_COPY"' EXIT
fi

base_tag() { git -C "$REPO" describe --tags --abbrev=0 --match 'v[0-9]*' custom; }

latest_release_tag() {
  git -C "$REPO" ls-remote --tags --refs upstream 'v[0-9]*.[0-9]*.[0-9]*' \
    | awk -F/ '{print $3}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}

# Pure helper (unit-tested): is release tag A strictly newer than B, by `sort -V` order.
version_gt() {
  [[ "$1" == "$2" ]] && return 1
  [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

orca_running() {
  # Why: the terminal daemon, helpers and the detached provider supervisor (`… -e …`) run the same
  # binary and outlive a quit. The main process is the binary with only `--switch` arguments
  # (orca-remote launches it with --user-data-dir); anything with a script, `-e` or `--type=` is not.
  # A false "not running" swaps the app out from under a live Orca, so err on "running". This also
  # catches a headless `orca serve` process (its args are all `--switch` too); linux_headless()
  # distinguishes that case so install can swap around it instead of waiting forever.
  local exe
  if (( IS_MAC )); then exe="$APP/Contents/MacOS/Orca"; else exe="$APP/orca-ide"; fi
  ps -axo args= | awk -v exe="$exe" '
    {
      n = split($0, arg, " ")
      if (arg[1] != exe) next
      main = 1
      for (i = 2; i <= n; i++) {
        if (arg[i] !~ /^--/ || arg[i] ~ /^--type=/ || arg[i] ~ /^--max-old-space-size/) { main = 0; break }
      }
      if (main) found = 1
    }
    END { exit !found }'
}

linux_headless() {
  (( IS_MAC )) && return 1
  systemctl --user is-active --quiet "$LINUX_SERVE_SERVICE" 2>/dev/null
}

linux_relaunch() {
  local was_headless=$1
  if (( was_headless )); then
    systemctl --user start "$LINUX_SERVE_SERVICE" >>"$LOG" 2>&1 || true
  elif [[ -x "$LINUX_ORCA_REMOTE" ]]; then
    "$LINUX_ORCA_REMOTE" off >>"$LOG" 2>&1 || true
  else
    setsid "$APP/orca-ide" >>"$LOG" 2>&1 </dev/null &
  fi
}

quit_app_mac() {
  osascript -e 'tell application "Orca" to quit' >/dev/null 2>&1 || true
  local waited=0
  while orca_running; do
    (( waited >= 60 )) && return 1
    sleep 2; waited=$((waited + 2))
  done
  return 0
}

# Why: HIDIdleTime is nanoseconds since the last key/mouse event, system-wide and privilege-free.
mac_idle_ns() {
  ioreg -c IOHIDSystem -d 1 2>/dev/null | awk -F'= ' '/"HIDIdleTime"/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

# Pure-ish helper (unit-tested via a stubbed `ioreg` function): idle >= 15 minutes on macOS.
quiet_time_ok() {
  (( IS_MAC )) || return 0
  local ns; ns=$(mac_idle_ns)
  [[ "$ns" =~ ^[0-9]+$ ]] || return 1
  (( ns / 1000000000 >= 900 ))
}

# Pure-ish helper (unit-tested via a stubbed `orca` function): true if any worktree has an agent
# mid-turn. Unknown (no `orca` CLI, or the call fails) is treated as "working" — same bias as
# orca_running(): a false "idle" would quit Orca out from under a live agent.
any_agent_working() {
  command -v orca >/dev/null 2>&1 || return 0
  local json; json=$(orca worktree ps --json 2>/dev/null) || return 0
  print -r -- "$json" | grep -q '"state": *"working"'
}

mac_quiet_for_install() {
  quiet_time_ok && ! any_agent_working
}

# The orcad template (remote runtime for SSH hosts) needs node-pty prebuilds from every platform's CI
# runner, so it cannot be built here. Our patches don't touch it: reuse the official one for the tag.
official_orcad_template() {
  local tag=$1 version=${1#v}
  local cache="$STATE/official/$tag"
  if [[ -d "$cache/orcad-template" ]]; then
    print -r -- "$cache/orcad-template"
    return 0
  fi
  rm -rf "$cache" && mkdir -p "$cache"
  log "downloading official $tag for its orcad template"
  if (( IS_MAC )); then
    curl -fsSL -o "$cache/release.zip" \
      "https://github.com/stablyai/orca/releases/download/$tag/Orca-$version-arm64-mac.zip" >>"$LOG" 2>&1
    unzip -q "$cache/release.zip" 'Orca.app/Contents/Resources/orcad-template/*' -d "$cache/x"
    mv "$cache/x/Orca.app/Contents/Resources/orcad-template" "$cache/orcad-template"
  else
    curl -fsSL -o "$cache/release.deb" \
      "https://github.com/stablyai/orca/releases/download/$tag/orca-ide_${version}_amd64.deb" >>"$LOG" 2>&1
    mkdir -p "$cache/x"
    bsdtar -xOf "$cache/release.deb" 'data.tar.*' | bsdtar -xf - -C "$cache/x"
    mv "$(find "$cache/x" -type d -name orcad-template -path '*/resources/*' | head -1)" "$cache/orcad-template"
  fi
  rm -rf "$cache/x" "$cache/release.zip" "$cache/release.deb"
  print -r -- "$cache/orcad-template"
}

build() {
  ensure_toolchain
  cd "$REPO"
  git checkout -q custom
  log "build: $(git log --oneline -1)"
  pnpm install --frozen-lockfile >>"$LOG" 2>&1
  # Why: mobile/ is a separate pnpm project; packaging asserts its web bundle exists.
  (cd mobile && pnpm install --frozen-lockfile) >>"$LOG" 2>&1
  pnpm run build:desktop >>"$LOG" 2>&1
  if (( IS_MAC )); then
    rm -rf native/computer-use-macos/.build native/keyboard-layout-macos/.build native/notification-status-macos/.build
    pnpm run build:computer-macos >>"$LOG" 2>&1
    pnpm run build:keyboard-layout-macos >>"$LOG" 2>&1
    pnpm run build:notification-status-macos >>"$LOG" 2>&1
  fi
  pnpm run ensure:electron-runtime >>"$LOG" 2>&1
  local commit version template
  commit=$(git rev-parse --short=12 HEAD)
  version="$(node -p "require('./package.json').version")-local.$(date +%s)000.$commit"
  template=$(official_orcad_template "$(base_tag)")
  if (( IS_MAC )); then
    rm -rf dist/mac-arm64
    ORCA_BUILD_COMMIT="$commit" ORCA_LOCAL_BUILD_VERSION="$version" \
      pnpm exec electron-builder --config config/electron-builder.config.cjs --mac dir --arm64 --publish never >>"$LOG" 2>&1
    rm -rf "$STAGED"
    ditto dist/mac-arm64/Orca.app "$STAGED"
    rm -rf "$STAGED/Contents/Resources/orcad-template"
    ditto "$template" "$STAGED/Contents/Resources/orcad-template"
    # Why: arm64 macOS requires a valid (ad-hoc is fine) signature over the final bundle contents.
    codesign --force --deep --sign - "$STAGED" >>"$LOG" 2>&1
  else
    rm -rf dist/linux-unpacked
    ORCA_BUILD_COMMIT="$commit" ORCA_LOCAL_BUILD_VERSION="$version" ORCA_SELF_BUILD_SKIP_GLIBC_FLOOR=1 \
      pnpm exec electron-builder --config config/electron-builder.config.cjs --linux dir --x64 --publish never >>"$LOG" 2>&1
    rm -rf "$STAGED"
    cp -a dist/linux-unpacked "$STAGED"
    rm -rf "$STAGED/resources/orcad-template"
    cp -a "$template" "$STAGED/resources/orcad-template"
  fi
  print -r -- "$version" >"$STATE/staged-version"
  git rev-parse HEAD >"$STATE/built-commit"
  log "staged $version"
}

# Why: a user-level desktop entry with the packaged entry's id shadows it, so launchers open ours.
write_linux_desktop_entry() {
  local system_entry=/usr/share/applications/orca-ide.desktop
  local user_entry="$HOME/.local/share/applications/orca-ide.desktop"
  mkdir -p "$(dirname "$user_entry")"
  if [[ -f "$system_entry" ]]; then
    sed "s|^Exec=.*orca-ide|Exec=$APP/orca-ide|" "$system_entry" >"$user_entry"
  else
    print -r -- "[Desktop Entry]
Name=Orca
Exec=$APP/orca-ide %U
Terminal=false
Type=Application
Icon=orca-ide
StartupWMClass=orca
Categories=Utility;" >"$user_entry"
  fi
  update-desktop-database "$(dirname "$user_entry")" >/dev/null 2>&1 || true
}

# Up to 120s via `orca status --json`: runtime.state == ready and appVersion == the staged version.
# No `orca` CLI available: treat as healthy (nothing to check), same as before this existed.
health_check() {
  local want=$1 waited=0 json state ver
  command -v orca >/dev/null 2>&1 || return 0
  while (( waited < 120 )); do
    json=$(orca status --json 2>/dev/null) || json=""
    if [[ -n "$json" ]]; then
      state=$(print -r -- "$json" | grep -m1 -o '"state": *"[a-zA-Z]*"' | sed -E 's/.*"([a-zA-Z]+)"$/\1/')
      ver=$(print -r -- "$json" | grep -m1 -o '"appVersion": *"[^"]*"' | sed -E 's/.*"([^"]*)"$/\1/')
      [[ "$state" == ready && "$ver" == "$want" ]] && return 0
    fi
    sleep 5; waited=$((waited + 5))
  done
  return 1
}

do_rollback() {
  local reason=$1 was_headless=${2:-0}
  if [[ ! -e "$PREV_APP" ]]; then
    log "rollback: no previous build at $PREV_APP"
    notify "Orca: откат невозможен" "Нет предыдущей сборки, почините вручную"
    return 1
  fi
  log "rollback: restoring previous build ($reason)"
  if (( IS_MAC )); then
    quit_app_mac || true
    rm -rf "$APP"
    mv "$PREV_APP" "$APP"
    xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
    open -a "$APP" >/dev/null 2>&1 || true
  else
    (( was_headless )) && (systemctl --user stop "$LINUX_SERVE_SERVICE" >>"$LOG" 2>&1 || true)
    rm -rf "$APP"
    mv "$PREV_APP" "$APP"
    write_linux_desktop_entry
    linux_relaunch "$was_headless"
  fi
  local prev; prev=$(cat "$STATE/installed-version.prev" 2>/dev/null || print "?")
  print -r -- "$prev" >"$STATE/installed-version"
  notify "Orca: откат" "Новая сборка не поднялась, вернул $prev"
  log "rollback: restored $prev"
}

rollback() {
  if [[ ! -e "$PREV_APP" ]]; then
    print "rollback: нечего откатывать ($PREV_APP не найден)"
    log "rollback: nothing to roll back to"
    return 1
  fi
  local was_headless=0
  if (( ! IS_MAC )) && linux_headless; then was_headless=1; fi
  if (( DRY_RUN_MODE )); then
    log "rollback: [dry-run] would restore $PREV_APP over $APP, relaunch (headless=$was_headless), notify"
    print "[dry-run] would restore $PREV_APP over $APP and relaunch"
    return 0
  fi
  do_rollback "ручной откат" "$was_headless"
}

health_check_or_rollback_mac() {
  local version=$1
  if health_check "$version"; then
    log "install: health check passed for $version"
    notify "Orca обновлена" "Установлена своя сборка $version"
  else
    log "install: health check FAILED for $version"
    do_rollback "сборка $version не поднялась"
  fi
}

health_check_or_rollback_linux() {
  local version=$1 was_headless=$2
  if health_check "$version"; then
    log "install: health check passed for $version"
    notify "Orca обновлена" "Установлена своя сборка $version"
  else
    log "install: health check FAILED for $version"
    do_rollback "сборка $version не поднялась" "$was_headless"
  fi
}

swap_app_mac() {
  local version=$1
  rm -rf "$PREV_APP"
  if [[ -d "$APP" ]]; then
    # Keep the first official app as a permanent fallback; later self-builds only feed PREV_APP.
    [[ -d "$OFFICIAL_BACKUP" ]] || ditto "$APP" "$OFFICIAL_BACKUP"
    mv "$APP" "$PREV_APP"
  fi
  mv "$STAGED" "$APP"
  xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
  [[ -f "$STATE/installed-version" ]] && cp "$STATE/installed-version" "$STATE/installed-version.prev"
  print -r -- "$version" >"$STATE/installed-version"
  rm -f "$STATE/staged-version"
  log "installed $version, relaunching for health check"
  open -a "$APP" >/dev/null 2>&1 || true
  health_check_or_rollback_mac "$version"
}

swap_app_linux() {
  local version=$1
  rm -rf "$PREV_APP"
  mkdir -p "$(dirname "$APP")"
  [[ -d "$APP" ]] && mv "$APP" "$PREV_APP"
  mv "$STAGED" "$APP"
  write_linux_desktop_entry
  [[ -f "$STATE/installed-version" ]] && cp "$STATE/installed-version" "$STATE/installed-version.prev"
  print -r -- "$version" >"$STATE/installed-version"
  rm -f "$STATE/staged-version"
  log "installed $version"
}

install_staged_mac() {
  local version=$1
  if orca_running; then
    if (( DRY_RUN_MODE )); then
      log "install: [dry-run] Orca running — would wait for 15min idle + no working agent, then quit, install $version, relaunch, health-check"
      return 0
    fi
    if ! mac_quiet_for_install; then
      log "install: Orca running, not a quiet moment (idle<15min or an agent is working) — retry later"
      return 0
    fi
    log "install: quiet moment — quitting Orca to install $version"
    if ! quit_app_mac; then
      log "install: Orca did not quit within 60s; giving up until next run"
      return 0
    fi
  elif (( DRY_RUN_MODE )); then
    log "install: [dry-run] Orca not running — would install $version immediately"
    return 0
  fi
  swap_app_mac "$version"
}

install_staged_linux() {
  local version=$1 running=0 headless=0
  orca_running && running=1
  linux_headless && headless=1
  if (( running && ! headless )); then
    log "install: Orca running (desktop) — will retry later"
    (( DRY_RUN_MODE )) && log "install: [dry-run] Orca running (desktop) — would wait"
    return 0
  fi
  if (( DRY_RUN_MODE )); then
    if (( headless )); then
      log "install: [dry-run] headless serve running — would stop $LINUX_SERVE_SERVICE, swap to $version, restart it, health-check"
    else
      log "install: [dry-run] Orca not running — would install $version and health-check"
    fi
    return 0
  fi
  if (( headless )); then
    log "install: headless serve running — stopping for swap"
    systemctl --user stop "$LINUX_SERVE_SERVICE" >>"$LOG" 2>&1 || true
  fi
  swap_app_linux "$version"
  linux_relaunch "$headless"
  health_check_or_rollback_linux "$version" "$headless"
}

install_staged() {
  [[ -d "$STAGED" ]] || { log "install: nothing staged"; return 0; }
  local version; version=$(<"$STATE/staged-version")
  if (( IS_MAC )); then
    install_staged_mac "$version"
  else
    install_staged_linux "$version"
  fi
}

# Commits named `upstream-pr(#N): …` are cherry-picked upstream PRs. Once PR N is merged and its merge
# commit is inside the new release, the release already has it: drop our copy instead of re-applying.
merged_patch_commits() {
  local current=$1 latest=$2 c n merge_commit
  for c in $(git rev-list --reverse "$current"..custom); do
    n=$(git log -1 --format=%s "$c" | sed -n 's/^upstream-pr(#\([0-9]*\)).*/\1/p')
    [[ -n "$n" ]] || continue
    merge_commit=$(gh pr view "$n" --repo stablyai/orca --json mergeCommit -q '.mergeCommit.oid // empty' 2>/dev/null || true)
    if [[ -n "$merge_commit" ]] && git merge-base --is-ancestor "$merge_commit" "$latest" 2>/dev/null; then
      print -r -- "$c"
    fi
  done
}

# Rebases custom's patches onto $1 (a release tag) in worktree $2, on a new branch sync/$1. On a
# conflict the worktree is left rebase-aborted (clean) and this returns 1; on success sync/$1 has
# $1 as an ancestor and this returns 0.
rebase_patches_onto() {
  local tag=$1 wt=$2 current
  current=$(base_tag)
  git -C "$REPO" worktree prune >>"$LOG" 2>&1 || true
  rm -rf "$wt"
  git -C "$REPO" worktree add -q -B "sync/$tag" "$wt" custom >>"$LOG" 2>&1
  local drops
  drops=$(merged_patch_commits "$current" "$tag" | tr '\n' ' ')
  [[ -n "$drops" ]] && log "sync: dropping patches merged upstream: $drops"
  # Why: the todo editor marks merged-upstream patches as `drop`; every other patch is re-applied.
  local todo_editor="$STATE/rebase-todo-editor"
  print -r -- '#!/bin/zsh
for sha in ${=ORCA_DROP_SHAS}; do perl -0pi -e "s/^pick (${sha:0:7}[0-9a-f]*) /drop \$1 /mg" "$1"; done' >"$todo_editor"
  chmod +x "$todo_editor"
  local ok=1
  if ( cd "$wt" && ORCA_DROP_SHAS="$drops" GIT_SEQUENCE_EDITOR="$todo_editor" \
      git rebase -q -i --onto "$tag" "$current" "sync/$tag" ) >>"$LOG" 2>&1; then
    ok=0
  else
    # Why: lockfile conflicts are expected (patches add dependencies); regenerate instead of merging.
    local conflicts; conflicts=$(cd "$wt" && git diff --name-only --diff-filter=U)
    if [[ "$conflicts" == "pnpm-lock.yaml" ]] \
      && ( cd "$wt" && git checkout "$tag" -- pnpm-lock.yaml && pnpm install --no-frozen-lockfile \
           && git add pnpm-lock.yaml && GIT_EDITOR=true git rebase --continue ) >>"$LOG" 2>&1; then
      ok=0
    else
      log "sync: conflict rebasing onto $tag: $conflicts"
      ( cd "$wt" && git rebase --abort ) >>"$LOG" 2>&1 || true
      ok=1
    fi
  fi
  (( ok == 0 )) && git -C "$wt" merge-base --is-ancestor "$tag" "sync/$tag" && return 0
  return 1
}

retry_stamp() { print -r -- "$STATE/sync-retry-$1"; }

# Never retry the same tag's conflict more than once a day.
should_retry_today() {
  local stamp; stamp=$(retry_stamp "$1")
  [[ -f "$stamp" && -n "$(find "$stamp" -mmin -1440 2>/dev/null)" ]] && return 1
  return 0
}

dispatch_conflict_agent() {
  local tag=$1
  if ! command -v orca >/dev/null 2>&1; then
    notify "Orca: нужна ручная правка" "Патчи не накладываются на $tag — нет orca CLI, агент не запущен"
    return 1
  fi
  if ! orca status --json >/dev/null 2>&1; then
    notify "Orca: нужна ручная правка" "Патчи не накладываются на $tag — Orca не запущена, агент не запущен"
    return 1
  fi
  log "sync: launching conflict-resolution agent for $tag"
  local prompt="Rebase custom onto $tag in this worktree, resolving conflicts. Log every resolution to ~/assistant/voice-lab/sync/resolutions-$tag.md. When the rebase lands cleanly, run \`orca-custom-update gate HEAD\` in this worktree and make sure it is green. Do not push anything."
  if orca worktree create --repo "path:$REPO" --name "sync-$tag" --no-parent --agent claude --prompt "$prompt" --json >>"$LOG" 2>&1; then
    notify "Orca: правлю $tag автоматически" "Агент чинит перенос патчей в sync-$tag"
    return 0
  fi
  notify "Orca: нужна ручная правка" "Патчи не накладываются на $tag, агент не запустился"
  return 1
}

# Pure helper (unit-tested): normalizes vitest's default-reporter failure lines so the same test
# failing twice, or with a different duration, compares equal.
normalize_test_failures() {
  grep '^ FAIL ' | sed -E 's/ [0-9]+ms$//' | LC_ALL=C sort -u
}

# Pure helper (unit-tested): failures in $1 that are not already in baseline $2, written to $3.
diff_new_failures() {
  comm -23 "$1" "$2" >"$3"
}

last_gate_summary() {
  local tag=$1
  local f="$STATE/gate-failures-$tag.txt"
  [[ -f "$f" ]] || { print -- "-"; return; }
  if [[ -s "$f" ]]; then print -- "red ($f)"; else print -- "green"; fi
}

# Computed once per tag in a clean worktree checked out at the tag (no patches), cached under
# $STATE/baseline-<tag>.txt.
ensure_baseline() {
  local tag=$1
  local baseline="$STATE/baseline-$tag.txt"
  [[ -f "$baseline" ]] && return 0
  log "gate: computing test baseline for $tag"
  local wt="$GATE_ROOT/baseline-$tag"
  git -C "$REPO" worktree prune >>"$LOG" 2>&1 || true
  rm -rf "$wt"
  git -C "$REPO" worktree add -q --detach "$wt" "$tag" >>"$LOG" 2>&1
  (
    cd "$wt"
    ensure_toolchain
    pnpm install --frozen-lockfile >>"$LOG" 2>&1 || pnpm install --no-frozen-lockfile >>"$LOG" 2>&1
    local out; out=$(mktemp)
    pnpm test >"$out" 2>&1 || true
    normalize_test_failures <"$out" >"$baseline.tmp"
    rm -f "$out"
  )
  [[ -f "$baseline.tmp" ]] && mv "$baseline.tmp" "$baseline"
  git -C "$REPO" worktree remove --force "$wt" >>"$LOG" 2>&1 || true
}

# Runs in the CURRENT directory (a worktree checked out at the ref to gate): frozen-lockfile install
# (falls back to regenerating the lockfile only on conflict), `pnpm tc`, `pnpm test` compared against
# the $1 baseline, `pnpm run build:electron-vite`. Writes new (non-baseline) failures to $2.
gate_checks() {
  local tag=$1 failfile=$2
  : >"$failfile"
  ensure_toolchain
  if ! pnpm install --frozen-lockfile >>"$LOG" 2>&1; then
    log "gate: lockfile conflict vs $tag; regenerating"
    pnpm install --no-frozen-lockfile >>"$LOG" 2>&1 || { log "gate: pnpm install failed"; return 1; }
  fi
  if ! pnpm run tc >>"$LOG" 2>&1; then
    log "gate: typecheck failed"
    return 1
  fi
  ensure_baseline "$tag"
  local out; out=$(mktemp)
  pnpm test >"$out" 2>&1 || true
  normalize_test_failures <"$out" >"$STATE/gate-test-$tag.txt"
  rm -f "$out"
  diff_new_failures "$STATE/gate-test-$tag.txt" "$STATE/baseline-$tag.txt" "$failfile"
  if [[ -s "$failfile" ]]; then
    log "gate: new test failures vs $tag baseline ($(wc -l <"$failfile" | tr -d ' ')): $failfile"
    return 1
  fi
  if ! pnpm run build:electron-vite >>"$LOG" 2>&1; then
    log "gate: build:electron-vite failed"
    return 1
  fi
  return 0
}

# `orca-custom-update gate <ref>` — runs the gate against <ref> in the CURRENT directory (meant to be
# run inside a worktree, e.g. by the conflict-resolution agent after it lands a rebase).
gate() {
  local ref=${1:-HEAD} tag
  if [[ "$ref" == v[0-9]*.[0-9]*.[0-9]* ]]; then
    tag=$ref
  else
    tag=$(git describe --tags --abbrev=0 --match 'v[0-9]*' "$ref" 2>/dev/null) || tag=$(base_tag)
  fi
  local failfile="$STATE/gate-failures-$tag.txt"
  if gate_checks "$tag" "$failfile"; then
    log "gate: green for $ref vs baseline $tag"
    print "gate: green ($ref vs baseline $tag)"
    return 0
  fi
  log "gate: red for $ref vs baseline $tag"
  print "gate: RED ($ref vs baseline $tag) — $failfile"
  return 1
}

sync() {
  cd "$REPO"
  local current; current=$(base_tag)
  if (( DRY_RUN_MODE )); then
    local latest
    if run_with_timeout 8 git fetch -q upstream --tags 2>/dev/null; then
      latest=$(latest_release_tag)
    else
      log "sync: [dry-run] upstream unreachable within 8s; would check for a release newer than $current"
      return 0
    fi
    if [[ "$current" == "$latest" ]] || ! version_gt "$latest" "$current"; then
      log "sync: [dry-run] up to date with $current (latest upstream: $latest)"
      return 0
    fi
    log "sync: [dry-run] would rebase custom onto $latest in sync/$latest, gate it against baseline-$latest, and on green move custom there, push, build, install"
    return 0
  fi
  git fetch -q upstream --tags
  local latest; latest=$(latest_release_tag)
  if [[ "$current" == "$latest" ]]; then
    log "sync: up to date with $current"
    return 0
  fi
  if ! version_gt "$latest" "$current"; then
    log "sync: latest tag $latest is not newer than current $current; skipping"
    return 0
  fi
  log "sync: $current -> $latest"
  # Why: REPO is also the dev checkout; a dirty tree makes the worktree carry it into the rebase.
  if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    log "sync: working tree has uncommitted changes; retrying later"
    notify "Orca: обновление $latest отложено" "Закоммитьте или уберите изменения в $REPO"
    return 1
  fi
  ensure_toolchain
  local wt="$GATE_ROOT/$latest"
  if ! should_retry_today "$latest"; then
    log "sync: already hit a conflict for $latest today; skipping until tomorrow"
    return 0
  fi
  if ! rebase_patches_onto "$latest" "$wt"; then
    touch "$(retry_stamp "$latest")"
    dispatch_conflict_agent "$latest"
    return 1
  fi
  rm -f "$(retry_stamp "$latest")"
  local failfile="$STATE/gate-failures-$latest.txt"
  if ! ( cd "$wt" && gate_checks "$latest" "$failfile" ); then
    log "sync: gate red for $latest; custom unchanged"
    notify "Orca $latest: ворота красные" "custom не тронут, список: $failfile"
    git -C "$REPO" worktree remove --force "$wt" >>"$LOG" 2>&1 || true
    return 1
  fi
  log "sync: gate green for $latest"
  # Why: `git branch -f custom …` refuses while custom is checked out here; reset --hard is the
  # equivalent for the branch the current worktree already has checked out.
  git -C "$REPO" checkout -q custom
  git -C "$REPO" reset --hard "sync/$latest"
  git -C "$REPO" worktree remove --force "$wt" >>"$LOG" 2>&1 || true
  git -C "$REPO" branch -D "sync/$latest" >>"$LOG" 2>&1 || true
  git push -q --force-with-lease origin custom >>"$LOG" 2>&1 || log "sync: push to fork failed (non-fatal)"
  git push -q -f origin "$latest^{commit}:refs/heads/release-base" >>"$LOG" 2>&1 || log "sync: release-base push failed (non-fatal)"
  build
  notify "Orca $latest собрана" "Ворота зелёные — установится в спокойный момент"
  install_staged
}

follow() {
  cd "$REPO"
  git fetch -q origin custom
  git fetch -q upstream --tags
  if [[ "$(cat "$STATE/built-commit" 2>/dev/null)" == "$(git rev-parse origin/custom)" ]]; then
    log "follow: up to date with origin/custom"
    return 0
  fi
  if (( DRY_RUN_MODE )); then
    log "follow: [dry-run] origin/custom moved to $(git rev-parse --short origin/custom) — would run pnpm tc, build, install"
    return 0
  fi
  log "follow: origin/custom -> $(git log --oneline -1 origin/custom)"
  git checkout -q -B custom origin/custom
  ensure_toolchain
  if ! pnpm run tc >>"$LOG" 2>&1; then
    log "follow: pnpm tc failed locally on origin/custom; keeping current app"
    notify "Orca: сборка не обновлена" "Проверка типов упала локально на $(git rev-parse --short origin/custom)"
    return 1
  fi
  build
  notify "Новая сборка Orca готова" "Закройте Orca полностью — она установится сама"
  install_staged
}

bootstrap_follower() {
  if [[ ! -d "$REPO/.git" ]]; then
    mkdir -p "$(dirname "$REPO")"
    git clone -q --filter=blob:none -b custom "$FORK_URL" "$REPO"
    git -C "$REPO" remote add upstream "$UPSTREAM_URL"
  fi
  print follower >"$ROLE_FILE"
  mkdir -p "$(dirname "$SCRIPT_LINK")"
  ln -sf "$REPO/fork/orca-custom-update" "$SCRIPT_LINK"
  if (( IS_MAC )); then
    local agent="$HOME/Library/LaunchAgents/com.roughriver74.orca-custom-update.plist"
    mkdir -p "$(dirname "$agent")" "$HOME/Library/Logs"
    cat >"$agent" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.roughriver74.orca-custom-update</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>$SCRIPT_LINK</string><string>auto</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/orca-custom-update.launchd.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/orca-custom-update.launchd.log</string>
</dict>
</plist>
PLIST
    launchctl bootout "gui/$(id -u)/com.roughriver74.orca-custom-update" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$agent"
  else
    local units="$HOME/.config/systemd/user"
    mkdir -p "$units"
    print -r -- "[Unit]
Description=Build and install the self-built Orca

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/bin/zsh $SCRIPT_LINK auto" >"$units/orca-custom-update.service"
    print -r -- "[Unit]
Description=Check for a new self-built Orca every 30 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min

[Install]
WantedBy=timers.target" >"$units/orca-custom-update.timer"
    systemctl --user daemon-reload
    systemctl --user enable --now orca-custom-update.timer
  fi
  log "bootstrap: follower ready; the scheduler builds and installs on its next tick"
}

# The scheduler runs `auto` every 30 min: install a staged build once Orca is closed/quiet, then check
# for a new build source at most every 6 h (maintainer: upstream release; follower: the fork's `custom`).
auto() {
  install_staged
  local stamp="$STATE/last-sync"
  if [[ -f "$stamp" && -n "$(find "$stamp" -mmin -360)" ]]; then
    return 0
  fi
  touch "$stamp"
  if [[ "$(cat "$ROLE_FILE" 2>/dev/null)" == follower ]]; then
    follow
  else
    sync
  fi
}

if [[ -z "${ORCA_CUSTOM_UPDATE_TEST:-}" ]]; then
  case "${1:-status}" in
    auto) auto ;;
    sync) sync ;;
    follow) follow ;;
    gate) gate "${2:-HEAD}" ;;
    rollback) rollback ;;
    bootstrap-follower) bootstrap_follower ;;
    build) build ;;
    install) install_staged ;;
    status)
      print "role:          $(cat "$ROLE_FILE" 2>/dev/null || print maintainer)"
      print "base release:  $(base_tag)"
      print "latest:        $(latest_release_tag)"
      print "installed:     $(cat "$STATE/installed-version" 2>/dev/null || print official)"
      print "previous:      $(cat "$STATE/installed-version.prev" 2>/dev/null || print -)"
      print "staged:        $(cat "$STATE/staged-version" 2>/dev/null || print -)"
      print "last gate:     $(last_gate_summary "$(latest_release_tag)")"
      ;;
    *) print -u2 "usage: orca-custom-update auto|sync|follow|gate|rollback|build|install|bootstrap-follower|status"; exit 2 ;;
  esac
fi
